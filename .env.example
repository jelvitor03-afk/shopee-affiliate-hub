# ==========================================
# Shopee Affiliate Hub - Configuracao Local
# ==========================================
# Copie este arquivo para ".env" (opcional).
# Quase todas as chaves tambem podem ser coladas direto no painel /admin!

PORT=3000
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000

# Meta Pixel & Conversions API (Tracker Shopee -> Meta)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Shopee Affiliate Open API (Brasil)
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.com.br/graphql

# WhatsApp Cloud API Oficial (Atendimento X1)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=shopee-hub-verify

# Inteligencia Artificial (Gemini ou OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Grupo de Achadinhos (Baileys)
WHATSAPP_GROUP_JID=
SHOPEE_KEYWORDS=oferta relampago,casa inteligente,cozinha
